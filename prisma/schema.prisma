// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StatusOS {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  APROVADA
  REPROVADA
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
}

enum TipoMovimentacao {
  ENTRADA
  BAIXA
  RESERVA
  LIBERACAO_RESERVA
}

enum StatusOrcamento {
  GERADO
  ENVIADO
  APROVADO
  REPROVADO
}

// ---------------------------------------------------------------------------
// Cadastros
// ---------------------------------------------------------------------------

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  cpf       String   @unique
  telefone  String?
  email     String?
  endereco  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  veiculos        Veiculo[]
  ordensDeServico OrdemDeServico[]

  @@map("clientes")
}

model Veiculo {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  placa     String   @unique
  marca     String
  modelo    String
  ano       Int?
  cor       String?
  kmAtual   Int?     @map("km_atual")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  ordensDeServico OrdemDeServico[]

  @@map("veiculos")
}

model Servico {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  precoBase Decimal  @map("preco_base") @db.Decimal(10, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  osItensServico OsItemServico[]

  @@map("servicos")
}

// ---------------------------------------------------------------------------
// Estoque
// ---------------------------------------------------------------------------

model Peca {
  id            String   @id @default(uuid())
  nome          String
  codigo        String?  @unique
  descricao     String?
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  qtdTotal      Int      @default(0) @map("qtd_total")
  qtdDisponivel Int      @default(0) @map("qtd_disponivel")
  qtdReservada  Int      @default(0) @map("qtd_reservada")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  osItensPeca          OsItemPeca[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@map("pecas")
}

model MovimentacaoEstoque {
  id         String           @id @default(uuid())
  pecaId     String           @map("peca_id")
  tipo       TipoMovimentacao
  quantidade Int
  osId       String?          @map("os_id")
  observacao String?
  createdAt  DateTime         @default(now()) @map("created_at")

  peca Peca            @relation(fields: [pecaId], references: [id])
  os   OrdemDeServico? @relation(fields: [osId], references: [id])

  @@map("movimentacoes_estoque")
}

// ---------------------------------------------------------------------------
// Ordem de Serviço
// ---------------------------------------------------------------------------

model OrdemDeServico {
  id                String    @id @default(uuid())
  numero            String    @unique
  clienteId         String    @map("cliente_id")
  veiculoId         String    @map("veiculo_id")
  status            StatusOS  @default(RECEBIDA)
  descricaoProblema String?   @map("descricao_problema")
  dataAbertura      DateTime  @default(now()) @map("data_abertura")
  dataFechamento    DateTime? @map("data_fechamento")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  cliente        Cliente               @relation(fields: [clienteId], references: [id])
  veiculo        Veiculo               @relation(fields: [veiculoId], references: [id])
  osItensServico OsItemServico[]
  osItensPeca    OsItemPeca[]
  orcamento      Orcamento?
  movimentacoes  MovimentacaoEstoque[]

  @@map("ordens_de_servico")
}

model OsItemServico {
  id            String    @id @default(uuid())
  osId          String    @map("os_id")
  servicoId     String    @map("servico_id")
  precoUnitario Decimal   @map("preco_unitario") @db.Decimal(10, 2)
  inicioExec    DateTime? @map("inicio_exec")
  fimExec       DateTime? @map("fim_exec")
  createdAt     DateTime  @default(now()) @map("created_at")

  os      OrdemDeServico @relation(fields: [osId], references: [id])
  servico Servico        @relation(fields: [servicoId], references: [id])

  @@map("os_itens_servico")
}

model OsItemPeca {
  id            String   @id @default(uuid())
  osId          String   @map("os_id")
  pecaId        String   @map("peca_id")
  quantidade    Int
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  utilizada     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  os   OrdemDeServico @relation(fields: [osId], references: [id])
  peca Peca           @relation(fields: [pecaId], references: [id])

  @@map("os_itens_peca")
}

// ---------------------------------------------------------------------------
// Orçamento
// ---------------------------------------------------------------------------

model Orcamento {
  id           String          @id @default(uuid())
  osId         String          @unique @map("os_id")
  status       StatusOrcamento @default(GERADO)
  valorTotal   Decimal         @map("valor_total") @db.Decimal(10, 2)
  dataGeracao  DateTime        @default(now()) @map("data_geracao")
  dataEnvio    DateTime?       @map("data_envio")
  dataResposta DateTime?       @map("data_resposta")
  observacoes  String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  os OrdemDeServico @relation(fields: [osId], references: [id])

  @@map("orcamentos")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  createdAt        DateTime @default(now())
}
